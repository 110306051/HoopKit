# Shared
NODE_ENV=development

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Mobile (these values are bundled into the client and must not contain secrets)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/v1
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Admin (NEXT_PUBLIC values are visible in the browser)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/v1
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Mux (server only)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=
MUX_CORS_ORIGIN=http://localhost:3000

# Observability
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
EXPO_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
