# Values prefixed with EXPO_PUBLIC_ are bundled into the app. Never put server
# secrets here. The code has localhost/Android-emulator defaults, but a physical
# phone must use the development computer's LAN IP (for example 192.168.1.20).
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/v1
EXPO_PUBLIC_SUPPORT_EMAIL=support@hoopkit.app
EXPO_PUBLIC_LEGAL_BASE_URL=http://localhost:3000

# Public DSN only. Never place a Sentry auth token in EXPO_PUBLIC_*.
EXPO_PUBLIC_SENTRY_DSN=

# Configure these as EAS secrets, never as EXPO_PUBLIC_* values.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
