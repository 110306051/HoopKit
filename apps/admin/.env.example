NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/v1
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Public contact shown in legal/support pages. Replace with an inbox you own.
NEXT_PUBLIC_SUPPORT_EMAIL=support@hoopkit.app

# Public DSN is safe to expose; never place a Sentry auth token here.
NEXT_PUBLIC_SENTRY_DSN=

# Optional build-time source-map upload. Server-only in Vercel.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=0.1
