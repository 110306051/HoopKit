NODE_ENV=development
# Railway/Render inject PORT automatically. API_PORT remains convenient locally.
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Server only. Never copy this value into Admin, Mobile, or NEXT_PUBLIC/EXPO_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Mux secrets only belong in the API environment.
MUX_TOKEN_ID=replace-with-mux-token-id
MUX_TOKEN_SECRET=replace-with-mux-token-secret
MUX_WEBHOOK_SECRET=replace-with-mux-webhook-secret
# Exact deployed Mobile Web origin in production. Local development falls back
# to * because every Mux direct-upload URL is single-use.
MUX_MOBILE_CORS_ORIGIN=http://localhost:8081
MUX_CORS_ORIGIN=http://localhost:3000

# Optional until Sentry is configured. Server-only DSN for API monitoring.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
